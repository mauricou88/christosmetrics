# =========================================================================
# CHRISTOSMETRICS — variables d'environnement de dev
# =========================================================================
# Copier ce fichier en .env puis adapter.
# JAMAIS COMMITTER le fichier .env final.

# ---- Base de données ----
DB_NAME=christosmetrics
DB_USER=christos
DB_PASSWORD=CHANGE_ME_DEV_PASSWORD

# ---- Secret JWT (OBLIGATOIRE) ----
# Générer avec : openssl rand -base64 64
APP_JWT_SECRET=CHANGE_ME_openssl_rand_base64_64_octets_minimum

# ---- CORS : origines autorisées (séparées par virgules) ----
# Ajouter capacitor://localhost (iOS) et http://localhost (Android) pour l'app mobile
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,http://localhost,https://localhost

# ---- Frontend ----
VITE_API_URL=http://localhost:8080

# ---- E-mail (optionnel en dev, actif=false = mode simulé) ----
APP_MAIL_ACTIF=false
# SMTP_HOST=smtp.mailjet.com
# SMTP_PORT=587
# SMTP_USER=xxx
# SMTP_PASSWORD=xxx
# SMTP_AUTH=true
# SMTP_STARTTLS=true

# Gmail : activer la validation en deux étapes et créer un mot de passe d'application.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASSWORD=mot_de_passe_application_google
# APP_MAIL_EXPEDITEUR=votre.adresse@gmail.com
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# APP_MAIL_ACTIF=true  (uniquement une fois les identifiants renseignés)
